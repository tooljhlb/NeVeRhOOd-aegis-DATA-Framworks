{
  "version": 1,
  "languages": [
    {
      "id": "rust",
      "extensions": [
        "rs"
      ],
      "filenames": [],
      "checks": [
        {
          "id": "rust-format",
          "kind": "format",
          "program": "cargo",
          "args": [
            "fmt",
            "--all",
            "--",
            "--check"
          ],
          "project_marker": "Cargo.toml"
        },
        {
          "id": "rust-clippy",
          "kind": "lint",
          "program": "cargo",
          "args": [
            "clippy",
            "--workspace",
            "--all-targets",
            "--locked",
            "--",
            "-D",
            "warnings"
          ],
          "project_marker": "Cargo.toml"
        }
      ]
    },
    {
      "id": "python",
      "extensions": [
        "py",
        "pyi"
      ],
      "filenames": [],
      "checks": [
        {
          "id": "python-lint",
          "kind": "lint",
          "program": "ruff",
          "args": [
            "check",
            "--output-format",
            "json",
            "{file}"
          ]
        }
      ]
    },
